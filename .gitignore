# Build output — never commit these. They are regenerated by `dotnet build`,
# and committing them would push hundreds of megabytes (including the 16 MB
# Android APK) to GitHub on every change.
bin/
obj/
[Bb]uild/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.dll
*.exe
*.pdb
*.apk
*.aab
*.ipa
*.app/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/
.nuget/

# App data written at runtime: uploaded e-catalogues, generated ZIP packs,
# and anything else the running system stores on disk.
App_Data/
src/Exb.Web/App_Data/

# Local secrets and machine-specific settings. Connection strings and mail
# passwords must never reach a public repository.
appsettings.Development.local.json
appsettings.Local.json
secrets.json
*.env

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Logs and temp
*.log
*.tmp
TestResults/
