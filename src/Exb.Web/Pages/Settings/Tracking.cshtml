@page
@model Exb.Web.Pages.Settings.TrackingModel
@{
    ViewData["Title"] = "Tracking & dwell";
}

<div class="page-head">
    <div>
        <h1>Tracking &amp; dwell</h1>
        <p class="lead">
            How badges are heard, and what counts as interest. These are the most consequential
            numbers in the system: they decide what an exhibitor is told about a visitor, and the
            daily report quotes them back to the visitor.
        </p>
    </div>
    <div class="actions"><button class="btn primary" type="submit" form="tracking-form">Save and restart tracking</button></div>
</div>

@if (Model.Message is not null)
{
    <div class="notice good">@Model.Message</div>
}
@if (Model.Problems.Count > 0)
{
    <div class="notice bad">
        <strong>Not saved</strong>
        <ul>
            @foreach (var problem in Model.Problems)
            {
                <li>@problem</li>
            }
        </ul>
    </div>
}

<div class="notice info">
    <strong>Right now</strong>
    A stand antenna at @Model.Tracking.KioskAntennas.HeightM m hears a badge up to
    <strong>@Model.KioskRadius m</strong> away
    @if (Model.Tracking.AisleGrid.Enabled)
    {
        <text>; an aisle antenna at @Model.Tracking.AisleGrid.HeightM m reaches <strong>@Model.AisleRadius m</strong></text>
    }.
    Measured coverage: @Model.Coverage.StandFloorLocalizablePct% of stand floor has three or more antennas,
    @Model.Coverage.WholeFloorDetectablePct% of the whole floor is heard at all.
</div>

<form method="post" id="tracking-form">
    <div class="grid c2">
        <div class="card">
            <header><h2>Stand antennas</h2></header>
            <div class="body">
                <p class="small muted">Each stand is issued antennas in proportion to its floor area. This is how the hardware is quoted and installed, and it makes sensing density follow the exhibitors rather than the building.</p>
                <div class="form-grid">
                    <div class="field">
                        <label>Area per antenna (m²)</label>
                        <input type="number" asp-for="Tracking.KioskAntennas.AreaPerAntennaM2" step="0.5" min="1" />
                        <div class="help">Lower means more antennas per stand and better attribution.</div>
                    </div>
                    <div class="field">
                        <label>Mounting height (m)</label>
                        <input type="number" asp-for="Tracking.KioskAntennas.HeightM" step="0.1" min="1.5" />
                        <div class="help">On the stand truss. Must be above badge height.</div>
                    </div>
                    <div class="field">
                        <label>Minimum per stand</label>
                        <input type="number" asp-for="Tracking.KioskAntennas.MinPerKiosk" min="1" max="8" />
                    </div>
                    <div class="field">
                        <label>Maximum per stand</label>
                        <input type="number" asp-for="Tracking.KioskAntennas.MaxPerKiosk" min="1" max="32" />
                    </div>
                    <div class="field">
                        <label>Ports per reader</label>
                        <input type="number" asp-for="Tracking.KioskAntennas.PortsPerReader" min="1" max="32" />
                    </div>
                    <div class="field">
                        <label>Port dwell (ms)</label>
                        <input type="number" asp-for="Tracking.KioskAntennas.DwellMs" min="20" max="2000" />
                        <div class="help">A reader visits one port at a time; this sets the revisit rate.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <header><h2>Aisle grid</h2></header>
            <div class="body">
                <p class="small muted">An optional sparse ceiling grid over the aisles. Stand antennas alone answer "which stand is this visitor at", which is what interest is built from; the aisle grid is what also shows the walking routes between stands.</p>
                <div class="field">
                    <label class="check">
                        <input type="hidden" asp-for="Tracking.AisleGrid.Enabled" value="false" />
                        <input type="checkbox" asp-for="Tracking.AisleGrid.Enabled" value="true" />
                        <span>Lay a ceiling grid over the aisles</span>
                    </label>
                </div>
                <div class="form-grid">
                    <div class="field">
                        <label>Grid pitch (m)</label>
                        <input type="number" asp-for="Tracking.AisleGrid.PitchM" step="0.5" min="2" />
                    </div>
                    <div class="field">
                        <label>Ceiling height (m)</label>
                        <input type="number" asp-for="Tracking.AisleGrid.HeightM" step="0.1" min="2" />
                    </div>
                    <div class="field">
                        <label>Ports per reader</label>
                        <input type="number" asp-for="Tracking.AisleGrid.PortsPerReader" min="1" max="32" />
                    </div>
                    <div class="field">
                        <label>Zone size (m)</label>
                        <input type="number" asp-for="Tracking.ZoneSizeM" step="0.5" min="1" />
                        <div class="help">Size of the wayfinding squares (A1, D7) used in reports.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid c2">
        <div class="card">
            <header><h2>What counts as interest</h2></header>
            <div class="body">
                <div class="form-grid">
                    <div class="field">
                        <label>Attach radius (m)</label>
                        <input type="number" asp-for="Dwell.AttachRadiusM" step="0.1" min="0" />
                        <div class="help">How far outside a stand's footprint still counts as being at it. Visitors stand at the edge, not inside.</div>
                    </div>
                    <div class="field">
                        <label>Minimum fix confidence</label>
                        <input type="number" asp-for="Dwell.MinConfidence" step="0.05" min="0" max="1" />
                        <div class="help">Below this a position is ignored rather than opening a visit.</div>
                    </div>
                    <div class="field">
                        <label>Minimum dwell (s)</label>
                        <input type="number" asp-for="Dwell.MinDwellSeconds" min="1" />
                        <div class="help">Below this it is recorded as a pass-by and never called interest.</div>
                    </div>
                    <div class="field">
                        <label>Interest at (s)</label>
                        <input type="number" asp-for="Dwell.InterestSeconds" min="2" />
                    </div>
                    <div class="field">
                        <label>Strong interest at (s)</label>
                        <input type="number" asp-for="Dwell.StrongSeconds" min="3" />
                    </div>
                    <div class="field">
                        <label>Break that ends a visit (s)</label>
                        <input type="number" asp-for="Dwell.BreakSeconds" min="5" />
                    </div>
                    <div class="field">
                        <label>Session cap (s)</label>
                        <input type="number" asp-for="Dwell.MaxSessionSeconds" min="60" />
                        <div class="help">A badge left on a stand counter overnight is not an eight-hour conversation.</div>
                    </div>
                    <div class="field">
                        <label>Minimum attribution margin (m)</label>
                        <input type="number" asp-for="Dwell.MinMarginM" step="0.05" min="0" />
                        <div class="help">If the neighbouring stand was almost as close on average, the visit is reported one level lower rather than guessed.</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <header><h2>Radio model</h2></header>
            <div class="body">
                <p class="small muted">Calibrate these against your own readers and a full hall. Everything downstream inherits them, so this is what turns good antenna geometry into good accuracy.</p>
                <div class="form-grid">
                    <div class="field">
                        <label>Reference RSSI at 1 m (dBm)</label>
                        <input type="number" asp-for="Tracking.Rf.RefRssiAt1M" step="0.5" />
                    </div>
                    <div class="field">
                        <label>Path-loss exponent</label>
                        <input type="number" asp-for="Tracking.Rf.PathLossExponent" step="0.1" min="0.5" />
                        <div class="help">Raise it for a crowded hall with metal stands.</div>
                    </div>
                    <div class="field">
                        <label>Reader sensitivity (dBm)</label>
                        <input type="number" asp-for="Tracking.Rf.SensitivityDbm" step="0.5" />
                    </div>
                    <div class="field">
                        <label>Beam exponent</label>
                        <input type="number" asp-for="Tracking.Rf.BeamExponent" step="0.1" min="0" />
                    </div>
                    <div class="field">
                        <label>Badge height (m)</label>
                        <input type="number" asp-for="Tracking.Rf.TagHeightM" step="0.05" min="0.3" />
                        <div class="help">Lanyard height.</div>
                    </div>
                    <div class="field">
                        <label>RSSI noise (dB)</label>
                        <input type="number" asp-for="Tracking.Locator.RssiNoiseDb" step="0.1" min="0.1" />
                        <div class="help">Drives the uncertainty circles on the live map.</div>
                    </div>
                    <div class="field">
                        <label>Read window (ms)</label>
                        <input type="number" asp-for="Tracking.Locator.WindowMs" min="200" />
                        <div class="help">Longer pools more antennas per fix but reacts more slowly.</div>
                    </div>
                    <div class="field">
                        <label>Solve interval (ms)</label>
                        <input type="number" asp-for="Tracking.Locator.IntervalMs" min="100" />
                    </div>
                    <div class="field">
                        <label>Smoothing (0–1)</label>
                        <input type="number" asp-for="Tracking.Locator.SmoothingAlpha" step="0.05" min="0" max="1" />
                    </div>
                    <div class="field">
                        <label>Solver iterations</label>
                        <input type="number" asp-for="Tracking.Locator.MaxIterations" min="1" max="30" />
                    </div>
                    <div class="field">
                        <label>Stale after (ms)</label>
                        <input type="number" asp-for="Tracking.Locator.StaleMs" min="1000" />
                    </div>
                    <div class="field">
                        <label>Gone after (ms)</label>
                        <input type="number" asp-for="Tracking.Locator.GoneMs" min="10000" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <header><h2>Simulator</h2></header>
        <div class="body">
            <p class="small muted">
                Synthetic visitors who walk the halls and stop at stands matching their interests, used
                when no readers are connected. It is ignored the moment a real reader endpoint is
                configured, so a cabled venue never gets synthetic visitors mixed into its live floor.
            </p>
            <div class="field">
                <label class="check">
                    <input type="hidden" asp-for="Simulator.Enabled" value="false" />
                    <input type="checkbox" asp-for="Simulator.Enabled" value="true" />
                    <span>Run the simulator when no readers are configured</span>
                </label>
            </div>
            <div class="form-grid">
                <div class="field">
                    <label>Badges on the floor</label>
                    <input type="number" asp-for="Simulator.VisitorCount" min="0" max="5000" />
                </div>
                <div class="field">
                    <label>Walking speed (m/s)</label>
                    <input type="number" asp-for="Simulator.WalkSpeedMps" step="0.1" min="0.2" />
                </div>
                <div class="field">
                    <label>Read dropout probability</label>
                    <input type="number" asp-for="Simulator.DropoutProbability" step="0.01" min="0" max="0.9" />
                </div>
                <div class="field">
                    <label>RSSI noise (dB)</label>
                    <input type="number" asp-for="Simulator.RssiNoiseDb" step="0.1" min="0" />
                </div>
                <div class="field">
                    <label>QR scan probability</label>
                    <input type="number" asp-for="Simulator.ScanProbability" step="0.05" min="0" max="1" />
                    <div class="help">Chance an interested visitor also scans the stand's code.</div>
                </div>
                <div class="field">
                    <label>Dwell scale</label>
                    <input type="number" asp-for="Simulator.DwellScale" step="0.1" min="0.05" />
                    <div class="help">Below 1 shortens simulated stops, so a rehearsal moves faster.</div>
                </div>
            </div>
        </div>
    </div>

    <button class="btn primary" type="submit">Save and restart tracking</button>
</form>
