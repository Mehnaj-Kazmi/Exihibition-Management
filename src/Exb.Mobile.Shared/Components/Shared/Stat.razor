<div style="text-align:center;padding:10px 4px;background:var(--surface-container);border-radius:var(--radius-m)">
    <div style="font-size:20px;font-weight:700">@Value</div>
    <div style="font-size:11px;color:var(--on-surface-variant)">@Label</div>
</div>

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public string Label { get; set; } = "";
}
