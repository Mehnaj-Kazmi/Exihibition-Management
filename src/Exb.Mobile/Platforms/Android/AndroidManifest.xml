<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      usesCleartextTraffic: Android 9 and later refuse plain-HTTP requests
      unless a app opts in, and the exhibition system is normally reached over
      the venue's own network at an http:// address the organiser types into
      the app. Without this the app cannot talk to the server at all — it
      reports "cannot reach the exhibition system" on every screen.

      The trade-off is deliberate: traffic on the venue LAN is unencrypted.
      When the organiser puts the system behind https, this can be tightened
      to a network-security-config that permits cleartext only for the
      specific hosts still needing it.
    -->
    <application android:allowBackup="true" android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon_round" android:supportsRtl="true" android:usesCleartextTraffic="true"></application>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required=false: the app is fully usable without a camera (manual code
         entry and the exhibitor page's Add button), so don't hide it from
         camera-less devices on the Play Store. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>